      v_exp_f16 v0, v0 dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1 // exp step 2
      s_nop 0                                            // 1 wait states
      v_pk_add_f16 v0, 1.0, v0 op_sel_hi:[0,1,1]         // e^2x + 1
      v_rcp_f16 v0, v0 dst_sel:WORD_0 dst_unused:UNUSED_PRESERVE src0_sel:WORD_0 // 1 / (1 + exp(-x))
      s_nop 0                                            // 1 wait states
      v_rcp_f16 v0, v0 dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1 // 1 / (1 + exp(-x))
      s_nop 0                                            // 1 wait states
      v_pk_fma_f16 v0, -2.0, v0, 2.0                     //  ( + 1 (fused))
      v_pk_mul_f16 v0, v[vgpr0], v0                      // x * (1 + tanh(...))
      v_pk_mul_f16 v0, 0.5, v0 op_sel_hi:[0,1,1]         // 0.5 * x * (1 + tanh(...))
      v_pk_mul_f16 v[vgpr0], s[sgpractivationAlpha], v0 op_sel_hi:[0,1,1] // 0.5 * x * (1 + tanh(...)) * scale
  
