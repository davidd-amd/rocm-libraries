      v_max_f16 v[vgpr0], s[sgpractivationAlpha], v[vgpr0] dst_sel:WORD_0 dst_unused:UNUSED_PRESERVE src0_sel:WORD_0 src1_sel:WORD_0 // max(alpha, min(x, beta))
      v_min_f16 v[vgpr0], s[sgpractivationBeta], v[vgpr0] dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1 src1_sel:WORD_1 // min(x, beta)
      v_max_f16 v[vgpr0], s[sgpractivationAlpha], v[vgpr0] dst_sel:WORD_1 dst_unused:UNUSED_PRESERVE src0_sel:WORD_1 src1_sel:WORD_1 // max(alpha, min(x, beta))
  
    ''',
